# App configuration
BACKEND_BASE_URL=
BACKEND_AUTH=
AUTH_TOKEN= #ABC1234 
PORT=3000

# MongoDB
# ถ้าใส่ MONGO_URI จะใช้ค่านี้เลย (ใส่ user/pass ใน URI ได้) และไม่สนใจ MONGO_HOST/PORT/DB/AUTH_SOURCE
# ไม่ใส่ จะใช้ MONGO_HOST/MONGO_PORT/MONGO_DB แทน (ค่าเริ่มต้น 127.0.0.1:27017/auto_test)
MONGO_URI=#
# ใช้ใน docker-compose.local.yml: container มองเครื่องตัวเองเป็น host.docker.internal

MONGO_HOST= 
MONGO_PORT= 
MONGO_DB=
MONGO_AUTH_SOURCE=
# user/pass แยก (ไม่ต้อง encode อักขระพิเศษ)
MONGO_USER=
MONGO_PASSWORD=

# SSH tunnel (เมื่อ SSH_ENABLED=true และไม่ได้ใส่ MONGO_URI จะต่อ 127.0.0.1:SSH_LOCAL_PORT ให้อัตโนมัติ)
SSH_ENABLED=false
SSH_HOST=
SSH_PORT=
SSH_USER=
SSH_PASSWORD=
SSH_PRIVATE_KEY_PATH=
SSH_PASSPHRASE=
SSH_DST_HOST=
SSH_DST_PORT=
SSH_LOCAL_PORT=

# data-pipeline: ฐานข้อมูลต้นทางที่ดึง sessions มาใส่ฐาน eval (ด้านบน) อ่านอย่างเดียว
# ตั้งได้จาก env เท่านั้น หน้าเว็บไม่แสดงค่าเหล่านี้ ไม่ตั้ง = เมนู data-pipeline ใช้งานไม่ได้
# ใส่ SOURCE_MONGO_URI หรือ SOURCE_MONGO_HOST + SOURCE_MONGO_DB
SOURCE_MONGO_URI=
SOURCE_MONGO_HOST=
SOURCE_MONGO_PORT=
SOURCE_MONGO_DB=
SOURCE_MONGO_AUTH_SOURCE=
SOURCE_MONGO_USER=
SOURCE_MONGO_PASSWORD=
# SSH tunnel ไปฐานต้นทาง เปิดเฉพาะตอนนับ/ดึง แล้วปิดหลังจบ (local port ต้องไม่ชนกับ SSH_LOCAL_PORT)
SOURCE_SSH_ENABLED=false
SOURCE_SSH_HOST=
SOURCE_SSH_PORT=
SOURCE_SSH_USER=
SOURCE_SSH_PASSWORD=
SOURCE_SSH_PRIVATE_KEY_PATH=
SOURCE_SSH_PASSPHRASE=
SOURCE_SSH_DST_HOST=
SOURCE_SSH_DST_PORT=
SOURCE_SSH_LOCAL_PORT=
# ค่าเริ่มต้นของงาน (แก้ได้จากหน้าเว็บ ค่าในหน้าเว็บสำคัญกว่า)
PIPELINE_JOB_ENABLED=true
# ทุกกี่ชั่วโมง: 1, 2, 3, 4, 6, 8, 12, 24
PIPELINE_INTERVAL_HOURS=24
# ดึงครั้งละกี่ session (1-1000)
PIPELINE_BATCH_LIMIT=50


# Auto QC job (Phase 1)
QC_JOB_ENABLED=true
# cron ทุก 1 ชม.
QC_JOB_CRON=0 * * * *
QC_LOOKBACK_HOURS=1
QC_SAMPLE_PERCENT=10
QC_MIN_DURATION_SECONDS=30 
QC_CONCURRENCY=3
QC_MAX_RETRY=2
QC_PROMPT_FILE=prompts/qc_judge.txt
QC_SCHEMA_FILE=prompts/qc_result.schema.json

# Gemini (Vertex AI) ใช้ SA key ในโฟลเดอร์ key/
SERVICE_ACCOUNT_FILE=service-account.json
# ไม่ใส่จะใช้ project_id จากไฟล์ SA
GCP_PROJECT_ID=
GCP_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0
# timeout ต่อ request ที่ส่งให้ Gemini (มิลลิวินาที) เกินแล้วนับเป็น error และ retry ตาม QC_MAX_RETRY
GEMINI_TIMEOUT_MS=120000
# อายุ signed URL ของไฟล์เสียงที่ส่งให้หน้า UI (นาที)
GCS_SIGNED_URL_TTL_MINUTES=60
# ตอนปิดระบบ (deploy/รีสตาร์ท) รอสายที่กำลังตรวจให้จบได้นานสุดกี่มิลลิวินาที ที่ไม่ทันจะตรวจต่อหลังเริ่มใหม่
# ควรน้อยกว่าเวลาที่ platform รอก่อนบังคับปิด (เช่น Kubernetes terminationGracePeriodSeconds ค่าเริ่มต้น 30 วินาที)
QC_SHUTDOWN_GRACE_MS=25000

# --- Login ด้วย Google (OAuth 2.0) ---
# ไฟล์ client ที่ดาวน์โหลดจาก Google Cloud Console (OAuth client แบบ Web) วางไว้ใน key/ (ไม่อยู่ใน git)
# หรือใส่ GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET แทนไฟล์
GOOGLE_OAUTH_CLIENT_FILE=google-oauth-client.json
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# ต้องลงทะเบียนใน "Authorized redirect URIs" ของ client เดียวกัน (dev ผ่าน Vite: http://localhost:5173/api/qc/auth/callback)
OAUTH_REDIRECT_URI=#http://localhost:5173/api/qc/auth/callback
# login ได้เฉพาะบัญชี Google Workspace ของโดเมนนี้
OAUTH_ALLOWED_DOMAIN=accentix.ai
# อายุการ login (ชั่วโมง) หมดแล้วต้อง login ใหม่
SESSION_TTL_HOURS=12
# เก็บประวัติการใช้งานย้อนหลังกี่วัน (เปลี่ยนค่าแล้วต้องลบ index at_1 ของ qc_audit_log ก่อนเริ่มระบบ)
QC_AUDIT_RETENTION_DAYS=365

